# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAQ v3 — free key from https://explore.openaq.org/register
OPENAQ_API_KEY=

# OpenAI — image generation for precomputed crossbreed pairings
OPENAI_API_KEY=

# Google Cloud — Street View Static API ("before" photos).
# Needs Street View Static API enabled on the project.
GOOGLE_API_KEY=

# Google Earth Engine — NDVI (Sentinel-2) + heat island (Landsat LST).
# Path to a service-account JSON key, plus the service account email.
GEE_SERVICE_ACCOUNT_JSON=./gee-service-account.json
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PROJECT_ID=
